# Copy to .env and fill in. .env is gitignored and must never be committed.

# Operational submission key (Stellar secret, starts with S).
# Generate and fund it yourself:
#   stellar keys generate --network testnet clara-facilitator
#   stellar keys address clara-facilitator   # fund this at lab.stellar.org/account/fund
#   stellar keys show clara-facilitator      # put the S... value below
# This key submits transactions and pays sponsored fees. It never holds a
# payer's funds and cannot sign on a payer's behalf, but it can be drained of
# its own fee balance, so fund it with an operating float only.
CLARA_SIGNER_SECRET=

# Networks to serve, comma-separated. Phase 0 is testnet only.
CLARA_NETWORKS=stellar:testnet

# Optional RPC overrides.
# CLARA_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
# CLARA_RPC_URL_PUBNET=https://mainnet.sorobanrpc.com

# Pay network fees on behalf of payers. Set to false to require clients to fund their own.
CLARA_SPONSOR_FEES=true

# Per-settlement fee ceiling in stroops. Verification rejects anything above it.
CLARA_MAX_FEE_STROOPS=50000

# Settlement database path.
CLARA_DB=data/settlements.sqlite

PORT=4021
